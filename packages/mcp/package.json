{
  "name": "@sodi/rx402-mcp",
  "version": "0.1.0",
  "description": "MCP server that gives AI agents a private wallet for x402 APIs, and private pay-per-request inference, with rx402.",
  "license": "Apache-2.0",
  "homepage": "https://sodi.network",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rowanweiss/sodi.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/rowanweiss/sodi/issues"
  },
  "keywords": [
    "mcp",
    "x402",
    "privacy",
    "ai-agents",
    "payments",
    "usdg",
    "robinhood-chain",
    "privacy-pools",
    "rx402"
  ],
  "type": "module",
  "bin": {
