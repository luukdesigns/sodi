# Robinhood Chain testnet
RPC_URL=https://rpc.testnet.chain.robinhood.com
CHAIN_ID=46630

# Name of the Foundry keystore used to deploy (create with: cast wallet import <name> --interactive).
# Use throwaway testnet keys only. Copy this file to .env, which git ignores; never commit keys.
DEPLOYER_ACCOUNT=sodi-testnet-deployer

# Entrypoint roles. On testnet these can be the deployer's address.
# OWNER_ADDRESS gets OWNER_ROLE (registers pools, upgrades). Use a multisig on mainnet.
OWNER_ADDRESS=
# POSTMAN_ADDRESS gets ASP_POSTMAN (publishes the approved-deposit root).
POSTMAN_ADDRESS=

# Approval service (asp/). Must hold ASP_POSTMAN on the Entrypoint. Testnet key only.
POSTMAN_PRIVATE_KEY=
VETTING_DELAY_SECONDS=1800

# Relayer (relayer/). Pays gas for session withdrawals.
RELAYER_PRIVATE_KEY=
RELAY_FEE_BPS=0

# MCP server (packages/mcp/)
RX402_MNEMONIC=
RELAYER_URL=http://localhost:8403
ASP_URL=http://localhost:8402
