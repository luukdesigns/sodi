    "test:e2e": "vitest run test/e2e"
  },
  "dependencies": {
    "@sodi/rx402": "*",
    "viem": "^2.22.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
